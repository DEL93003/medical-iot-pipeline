          "rawSql": "SELECT timestamp AS \"time\", serial_number AS \"metric\", vacuum_pressure AS \"value\" FROM telemetry WHERE $__timeFilter(timestamp) AND serial_number NOT LIKE 'TEST-%' ORDER BY timestamp ASC;",
          "refId": "A"

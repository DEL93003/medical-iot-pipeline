      "id": 1,
      "title": "Fluid Volume Monitoring (L) [Alarm > 3.5L]",
      "type": "timeseries",
      "datasource": "TimescaleDB",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "spanNulls": true,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 3.0 },
              { "color": "red", "value": 3.5 }
            ]
          },
          "unit": "litre"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "TimescaleDB",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('5 seconds', timestamp) AS time,\n  serial_number AS metric,\n  AVG(fluid_volume) AS value\nFROM telemetry\nWHERE $__timeFilter(timestamp)\n  AND serial_number NOT LIKE 'TEST-%'\nGROUP BY 1, 2\nORDER BY 1 ASC;",
          "refId": "A"
        }
      ]
    },

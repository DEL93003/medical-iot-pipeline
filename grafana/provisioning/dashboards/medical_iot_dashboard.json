      },
      "id": 3,
      "title": "Fleet Health & Live Connectivity Status",
      "type": "table",
      "datasource": "TimescaleDB",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "ONLINE": { "color": "dark-green", "index": 0 }, "OFFLINE": { "color": "dark-red", "index": 1 } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": "TimescaleDB",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (serial_number)\n  serial_number AS \"Device Serial\",\n  zone AS \"Zone\",\n  motor_state AS \"Motor State\",\n  filter_status AS \"Filter Status\",\n  vacuum_pressure AS \"Vacuum (mmHg)\",\n  fluid_volume AS \"Fluid Vol (L)\",\n  CASE\n    WHEN timestamp >= NOW() - INTERVAL '30 seconds' THEN 'ONLINE'\n    ELSE 'OFFLINE'\n  END AS \"Status\",\n  timestamp AS \"Last Heartbeat (UTC)\"\nFROM telemetry\nWHERE serial_number NOT LIKE 'TEST-%'\nORDER BY serial_number, timestamp DESC;",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
